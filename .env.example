# Django production settings
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-me-generate-a-long-random-secret
DJANGO_ALLOWED_HOSTS=example.com,www.example.com,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_CSRF_COOKIE_SECURE=True
CODEMASTER_AUTH_COOKIE_SECURE=True
DJANGO_LOG_LEVEL=INFO

# Web worker timeout. Keep this greater than HOMEWORK_LLM_TIMEOUT_SECONDS and
# VOLC_VISION_READ_TIMEOUT_SECONDS so Django can catch upstream API timeouts,
# write HomeworkImportJob.parse_notes, and fall back when configured.
GUNICORN_TIMEOUT=180

# Static and media paths inside the web container
DJANGO_STATIC_ROOT=/app/staticfiles
DJANGO_MEDIA_ROOT=/app/media

# PostgreSQL
# Migration target matches the current Tencent Cloud source database major version:
# PostgreSQL 15.16 source -> postgres:15 Docker image.
POSTGRES_DB=codemaster
POSTGRES_USER=codemaster_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# Realtime classroom state
REDIS_URL=redis://redis:6379/0

# LiveKit / WebRTC. Local docker-compose can use devkey/secret; production must
# replace these and expose LIVEKIT_PUBLIC_URL as wss://your-livekit-domain.
LIVEKIT_PUBLIC_URL=ws://127.0.0.1:7880
LIVEKIT_SERVER_URL=http://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=dev-secret-change-me-32-bytes-minimum
LIVEKIT_CLIENT_JS_URL=https://cdn.jsdelivr.net/npm/livekit-client/dist/livekit-client.umd.min.js
LIVEKIT_RECORDING_ENABLED=True
LIVEKIT_RECORDING_FILE_PREFIX=/recordings/live-classroom
LIVEKIT_RECORDING_PUBLIC_URL_PREFIX=/media/live-classroom
LIVEKIT_USE_EXTERNAL_IP=False
LIVEKIT_NODE_IP=127.0.0.1
LIVEKIT_RTC_PORT_RANGE_START=50000
LIVEKIT_RTC_PORT_RANGE_END=50100

# Scratch programming editor used by mock-exam programming questions.
# Local compose exposes the editor directly on 8601; production can serve it at /scratch/editor.html.
DASHIMA_SCRATCH_EDITOR_URL=http://127.0.0.1:8601/editor.html

# Homework import routing and diagnostics
HOMEWORK_IMPORT_ROUTER_ENABLED=False
HOMEWORK_IMPORT_DEBUG=False
HOMEWORK_PARSE_REQUIRE_REVIEW=True
HOMEWORK_IMPORT_ALLOW_FALLBACK_HEURISTIC=False
HOMEWORK_IMPORT_STALE_MINUTES=30

# Qwen / DashScope text structuring
HOMEWORK_PARSE_PROVIDER_TEXT=qwen
DASHSCOPE_API_KEY=
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_OCR_MODEL=qwen3.6-plus
QWEN_OCR_ENABLE_THINKING=false
QWEN_TEMPERATURE=0
QWEN_TOP_P=0.1
QWEN_TIMEOUT_SECONDS=180
QWEN_MAX_RETRIES=3
EXAM_PDF_RENDER_DPI=300
EXAM_QWEN_OCR_CONCURRENCY=2
HOMEWORK_LLM_MODEL=qwen3.6-plus
HOMEWORK_LLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
HOMEWORK_LLM_TIMEOUT_SECONDS=60
HOMEWORK_LLM_MAX_RETRIES=0
HOMEWORK_LLM_RETRY_BACKOFF_SECONDS=1.0
HOMEWORK_LLM_TEXT_BLOCK_MAX_CHARS=500
HOMEWORK_IMPORT_SUPPLEMENT_MISSING_ANSWERS=true

# Volcengine Ark vision OCR
HOMEWORK_PARSE_PROVIDER_OCR=volc_vision
ARK_API_KEY=
VOLC_VISION_MODEL=doubao-seed-1-6-vision-250815
VOLC_VISION_API_URL=https://ark.cn-beijing.volces.com/api/v3/responses
VOLC_VISION_TIMEOUT_SECONDS=40
VOLC_VISION_CONNECT_TIMEOUT_SECONDS=10
VOLC_VISION_READ_TIMEOUT_SECONDS=60
VOLC_VISION_MAX_RETRIES=2
VOLC_VISION_RETRY_BACKOFF_SECONDS=0.2

# SSL verification for outbound homework API requests
HOMEWORK_SSL_VERIFY=True
HOMEWORK_SSL_CA_BUNDLE=
HOMEWORK_REQUESTS_USER_AGENT=codemaster-homework-import/1.0

# PDF OCR routing thresholds
HOMEWORK_PDF_FORCE_OCR=False
HOMEWORK_PDF_MIN_TEXT_LENGTH=200
HOMEWORK_PDF_MIN_LINE_COUNT=8

# WeChat miniapp login
WECHAT_MINIAPP_APPID=
WECHAT_MINIAPP_SECRET=

# Hermes internal ingest API
HERMES_INGEST_TOKEN=

# Local-only fallback accounts/imports. Leave empty in production.
CODEMASTER_DEFAULT_TEST_PASSWORD=
CODEMASTER_IMPORT_DEFAULT_PASSWORD=
